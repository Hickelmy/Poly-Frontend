# =============================================
# API
# =============================================
VITE_API_URL=http://localhost:3001

# =============================================
# CRIPTOGRAFIA
# =============================================
# Mesma chave usada no backend (ENCRYPTION_MASTER_KEY)
# Gere com: openssl rand -base64 32
VITE_ENCRYPTION_MASTER_KEY="sua-chave-mestre-aqui"

# =============================================
# FIREBASE (Google Login)
# =============================================
# Encontre em: Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-firebase"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
